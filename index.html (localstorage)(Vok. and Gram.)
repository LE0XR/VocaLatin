const lessonButtons = document.getElementById("lessons");
const content = document.getElementById("content");
const search = document.getElementById("search");
const status = document.getElementById("status");
let selectedLesson = null;

for(let i=1;i<=30;i++){
  const b=document.createElement("button");
  b.textContent=i;
  b.dataset.lesson=i;
  b.addEventListener("click",()=>{
    selectedLesson = (selectedLesson===i ? null : i);
    document.querySelectorAll(".lessons button").forEach(x=>x.classList.toggle("active", Number(x.dataset.lesson)===selectedLesson));
    document.getElementById("allBtn").classList.toggle("active", selectedLesson===null);
    render();
  });
  lessonButtons.appendChild(b);
}

document.getElementById("allBtn").onclick=()=>{
  selectedLesson=null;
  document.querySelectorAll(".lessons button").forEach(x=>x.classList.remove("active"));
  document.getElementById("allBtn").classList.add("active");
  render();
};

document.getElementById("clearBtn").onclick=()=>{
  search.value="";
  selectedLesson=null;
  document.querySelectorAll(".lessons button").forEach(x=>x.classList.remove("active"));
  document.getElementById("allBtn").classList.add("active");
  render();
};

search.addEventListener("input",render);

function esc(s){
  return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
}
function mark(s,q){
  let out=esc(s);
  if(!q) return out;
  const re=new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,"\\$&"),"ig");
  return out.replace(re,m=>`<span class="match">${m}</span>`);
}
function render(){
  const q=search.value.trim().toLowerCase();
  content.innerHTML="";
  let shown=0, total=0;

  DATA.forEach(src=>{
    const rows=[];
    src.pages.forEach(item=>{
      total++;
      const text=item.text.toLowerCase();
      const lessonOK=selectedLesson===null || item.lessons.includes(selectedLesson);
      const searchOK=!q || text.includes(q);
      if(lessonOK && searchOK) rows.push(item);
    });
    if(rows.length){
      shown += rows.length;
      const page=document.createElement("section");
      page.className="page";
      page.innerHTML=`<div class="pagehead">${esc(src.source)} · ${rows.length} Treffer</div>`+
        rows.map(r=>`<div class="line">${mark(r.text,q)}</div>`).join("");
      content.appendChild(page);
    }
  });

  status.textContent = `${shown} Zeilen angezeigt${selectedLesson?` · Lektion ${selectedLesson}`:""}${q?` · Suche: „${q}“`:""}`;
  if(!shown) content.innerHTML='<div class="empty">Keine passenden Einträge gefunden.</div>';
}
render();
</script>
