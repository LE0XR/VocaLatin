<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VocaLatin – Latein lernen</title>
<style>
:root{--purple:#3b2f5b;--light:#f4f1ea;--card:#fff;--text:#222;--muted:#6b6872;--green:#dff2df;--red:#f8dddd}
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--light);color:var(--text)}
header{background:linear-gradient(135deg,#30244f,#4b3b72);color:#fff;padding:24px 18px;text-align:center}header h1{margin:0;font-size:32px}header p{margin:6px 0 0;opacity:.9}
nav{display:flex;gap:8px;padding:10px;background:#fff;position:sticky;top:0;z-index:10;overflow-x:auto;box-shadow:0 2px 8px #0001}nav button{border:0;background:#eee8df;padding:11px 14px;border-radius:12px;font-weight:bold;white-space:nowrap}nav button.active{background:var(--purple);color:#fff}
main{max-width:900px;margin:auto;padding:16px}section{display:none}section.active{display:block}.card{background:var(--card);border-radius:18px;padding:20px;margin:14px 0;box-shadow:0 3px 12px #00000012}h2{margin-top:0;color:var(--purple)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.bigbtn{border:0;border-radius:16px;padding:20px;background:#fff;box-shadow:0 3px 12px #0002;font-size:17px;font-weight:bold;text-align:left}.bigbtn span{font-size:28px;display:block;margin-bottom:8px}
select,input{width:100%;padding:13px;border:1px solid #ccc;border-radius:10px;font-size:16px;background:#fff}button.action{border:0;background:var(--purple);color:#fff;padding:12px 18px;border-radius:10px;font-weight:bold;margin-top:10px;cursor:pointer}.secondary{background:#eee8df!important;color:#30244f!important}
.answer{font-size:28px;text-align:center;padding:18px;min-height:70px;font-weight:bold}.flash{min-height:190px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:34px;background:#faf7f1;border-radius:15px;padding:20px;cursor:pointer;user-select:none}
.progressbar{height:18px;background:#eee;border-radius:20px;overflow:hidden}.progressbar div{height:100%;background:var(--purple);width:0;transition:.3s}.small{color:var(--muted);font-size:14px}.good,.bad{border:0;padding:12px 18px;border-radius:10px;font-weight:bold;margin:6px;cursor:pointer}.good{background:var(--green);color:#206020}.bad{background:var(--red);color:#8b2020}
.lessonGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(85px,1fr));gap:8px}.lesson{padding:11px;border:0;border-radius:10px;background:#eee8df;font-weight:bold;cursor:pointer}.lesson.active{background:var(--purple);color:#fff}.choices{display:grid;gap:10px;margin-top:12px}.choice{border:1px solid #ddd;background:#fff;padding:13px;border-radius:10px;text-align:left;font-size:16px;cursor:pointer}.choice:hover{background:#f5f1fb}.wordlist{max-height:430px;overflow:auto}.wordrow{display:flex;justify-content:space-between;gap:10px;padding:10px 4px;border-bottom:1px solid #eee}.badge{font-size:12px;background:#eee8df;border-radius:20px;padding:5px 8px;white-space:nowrap}.star{border:0;background:none;font-size:20px;cursor:pointer}.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.statbox{background:#faf7f1;padding:15px;border-radius:12px;text-align:center}.statbox b{display:block;font-size:24px;color:var(--purple)}
</style>
</head>
<body>
<header><h1>🏛️ VocaLatin</h1><p>Latein lernen – einfach, schnell und effektiv</p></header>
<nav>
<button class="active" onclick="show('home',this)">🏠 Start</button><button onclick="show('quiz',this)">📖 Latein → Deutsch</button><button onclick="show('reverse',this)">🇩🇪 Deutsch → Latein</button><button onclick="show('cards',this)">🗂️ Karteikarten</button><button onclick="show('search',this)">🔎 Suchen</button><button onclick="show('grammar',this)">✏️ Grammatik</button><button onclick="show('stats',this)">📊 Fortschritt</button>
</nav>
<main>
<section id="home" class="active">
<div class="card"><h2>Was möchtest du lernen?</h2><div class="grid"><button class="bigbtn" onclick="openSection('quiz')"><span>📖</span>Latein → Deutsch</button><button class="bigbtn" onclick="openSection('reverse')"><span>🇩🇪</span>Deutsch → Latein</button><button class="bigbtn" onclick="openSection('cards')"><span>🗂️</span>Karteikarten</button><button class="bigbtn" onclick="openSection('search')"><span>🔎</span>Vokabeln suchen</button></div></div>
<div class="card"><h2>📚 Lektion auswählen</h2><p class="small">Die Zahlen hinter den Vokabeln im Register sind die Lektionen.</p><div id="homeLessons" class="lessonGrid"></div></div>
<div class="card"><h2>📊 Dein Fortschritt</h2><p><b id="homeScore">0</b> richtige von <b id="homeTotal">0</b> Antworten</p><div class="progressbar"><div id="homeBar"></div></div><p class="small" id="homeLessonInfo"></p></div>
</section>

<section id="quiz"><div class="card"><h2>📖 Latein → Deutsch</h2><label>Lektion</label><select id="quizLesson" onchange="newQuiz()"></select><p>Was bedeutet:</p><div class="answer" id="qWord"></div><div id="choices" class="choices"></div><p id="qFeedback"></p><button class="action" onclick="newQuiz()">Nächste Vokabel</button></div></section>
<section id="reverse"><div class="card"><h2>🇩🇪 Deutsch → Latein</h2><label>Lektion</label><select id="reverseLesson" onchange="newReverse()"></select><p>Wie heißt das auf Latein?</p><div class="answer" id="rWord"></div><input id="rInput" placeholder="Lateinisches Wort eingeben" onkeydown="if(event.key==='Enter')checkReverse()"><button class="action" onclick="checkReverse()">Antwort prüfen</button><p id="rFeedback"></p><button class="action" onclick="newReverse()">Nächste Vokabel</button></div></section>
<section id="cards"><div class="card"><h2>🗂️ Karteikarten</h2><label>Lektion</label><select id="cardLesson" onchange="newCard()"></select><p class="small">Tippe auf die Karte, um die Übersetzung zu sehen.</p><div class="flash" id="flash" onclick="flipCard()"></div><div style="text-align:center"><button class="good" onclick="cardResult(true)">✅ Gewusst</button><button class="bad" onclick="cardResult(false)">❌ Nicht gewusst</button></div><p id="cardFeedback"></p></div></section>
<section id="search"><div class="card"><h2>🔎 Vokabelsuche</h2><input id="searchInput" placeholder="Latein oder Deutsch eingeben…" oninput="renderSearch()"><select id="searchLesson" onchange="renderSearch()"></select><div id="wordList" class="wordlist" style="margin-top:12px"></div></div></section>
<section id="grammar"><div class="card"><h2>✏️ Grammatik</h2><div class="grid"><div class="card"><b>Substantive</b><p>Nom. – Gen. – Dat. – Akk. – Abl.</p></div><div class="card"><b>Verben</b><p>Präsens, Imperfekt, Perfekt und weitere Zeiten.</p></div><div class="card"><b>Konjugationen</b><p>amare – monere – regere – audire</p></div><div class="card"><b>Fälle</b><p>Erkenne die Funktion eines Wortes im Satz.</p></div><div class="card"><b>Partizipien</b><p>z. B. PPP und PPA erkennen und übersetzen.</p></div><div class="card"><b>Satzbau</b><p>Subjekt, Prädikat, Objekt und typische lateinische Satzstellung.</p></div></div></div></section>
<section id="stats"><div class="card"><h2>📊 Dein Lernfortschritt</h2><div class="statgrid"><div class="statbox"><b id="score">0</b>richtig</div><div class="statbox"><b id="wrong">0</b>falsch</div><div class="statbox"><b id="total">0</b>gesamt</div></div><p style="margin-top:18px">Trefferquote</p><div class="progressbar"><div id="bar"></div></div><p id="quote"></p><button class="action secondary" onclick="resetStats()">Fortschritt zurücksetzen</button></div><div class="card"><h2>⭐ Schwierige Vokabeln</h2><div id="difficult"></div></div></section>
</main>
<script>
// Die Datenstruktur enthält die Lektion. Weitere Einträge können einfach als [latein,deutsch,lektion] ergänzt werden.
const vocab=[
['a','von, von ... her','6'],['abire','weggehen','14'],['abesse','abwesend sein, fehlen','24'],['accedere','herankommen, hinzukommen','21'],['accipere','annehmen, erhalten','11'],['addere','hinzufügen','21'],['adiuvare','helfen','6'],['adire','herantreten, aufsuchen','22'],['aedificare','bauen, errichten','26'],['ager','Acker, Feld, Gebiet','5'],['agere','tun, handeln, treiben','21'],['amare','lieben','3'],['amicus','Freund','2'],['amicitia','Freundschaft','21'],['amor','Liebe','7'],['annus','Jahr','7'],['aqua','Wasser','2'],['arena','Sand, Kampfplatz','15'],['arma','Waffe','8'],['ars','Kunst, Fertigkeit','1'],['audire','hören','4'],['auxilium','Hilfe','6'],['bellum','Krieg','10'],['bene','gut','4'],['bibere','trinken','6'],['bonus','gut, tüchtig','5'],['brevis','kurz','26'],['cadere','fallen','8'],['caelum','Himmel','10'],['campus','Feld, Platz','16'],['canis','Hund','27'],['capere','fassen, nehmen, erobern','6'],['carus','teuer, wertvoll','6'],['causa','Ursache, Grund','23'],['cibus','Nahrung, Speise, Futter','2'],['circum','um ... herum','10'],['civis','Bürger','10'],['clausus','geschlossen','23'],['cogere','zwingen','23'],['cognoscere','erkennen, kennenlernen','21'],['colere','bewirtschaften, pflegen, verehren','19'],['colligere','sammeln','28'],['communis','gemeinsam, allgemein','12'],['comparare','vergleichen','26'],['comprehendere','begreifen, erfassen','9'],['concedere','erlauben, nachgeben','12'],['conficere','fertig machen, beenden','21'],['conjugere','verbinden, vereinigen','27'],['consilium','Beratung, Beschluss, Plan, Rat','4'],['constituere','festsetzen, beschließen','18'],['consul','Konsul','21'],['contendere','kämpfen, eilen, behaupten','11'],['corpus','Körper, Leib','16'],['credere','glauben, anvertrauen','12'],['cura','Sorge, Pflege','12'],['curare','pflegen, sorgen für','8'],['dare','geben','7'],['debere','müssen, sollen, schulden','1'],['decem','zehn','16'],['deus','Gott','4'],['dicere','sagen, sprechen','9'],['dignus','würdig, wert','15'],['diligere','hochachten, lieben','14'],['discedere','auseinandergehen','20'],['discere','lernen','20'],['dividere','teilen, trennen','27'],['docere','lehren, unterrichten','2'],['dolere','schmerzen','30'],['dominus','Herr','1'],['domus','Haus','16'],['dux','Anführer','10'],['edere','herausgeben','6'],['efficere','bewirken, herstellen','20'],['errare','sich irren','5'],['exercere','üben, trainieren, quälen','7'],['facere','machen, tun, handeln','8'],['familia','Familie','3'],['filius','Sohn','3'],['fortuna','Schicksal, Glück','12'],['frater','Bruder','7'],['gaudere','sich freuen','9'],['gratia','Dank, Gunst','23'],['habere','haben, halten','2'],['hodie','heute','7'],['honor','Ehre','3'],['hostis','Feind','12'],['imperare','befehlen, herrschen','5'],['imperium','Befehl, Herrschaft, Reich','5'],['interrogare','fragen','18'],['invenire','finden','5'],['ira','Zorn','17'],['iter','Reise, Weg','24'],['labor','Arbeit, Anstrengung','9'],['laetus','froh, fruchtbar','13'],['laudare','loben','5'],['legere','lesen, auswählen','14'],['liber','Buch','5'],['libertas','Freiheit','7'],['lingua','Sprache','21'],['locus','Ort, Platz, Stelle','11'],['lux','Licht, Tageslicht','8'],['magnus','groß, bedeutend','5'],['manus','Hand','13'],['mater','Mutter','7'],['medius','mittlerer, Mitte','13'],['memoria','Erinnerung, Gedächtnis','30'],['mensa','Tisch','3'],['mittere','schicken, lassen','6'],['modus','Art, Weise, Maß','18'],['monere','mahnen, ermahnen','1'],['mors','Tod','7'],['movere','bewegen','3'],['multus','viel','5'],['munire','befestigen, schützen','10'],['narrāre','erzählen','5'],['necesse','notwendig','18'],['nemo','niemand','16'],['niger','schwarz, dunkel','5'],['nobis','uns','5'],['non','nicht','1'],['novus','neu','5'],['numerus','Zahl, Menge','16'],['obire','sterben, umkommen','15'],['omnis','jeder, ganz','11'],['oppugnare','angreifen','30'],['ordinare','ordnen','12'],['parare','vorbereiten, erwerben','3'],['parvus','klein, gering','5'],['patria','Heimat','3'],['pauci','wenige','17'],['pax','Frieden','10'],['pecunia','Geld','19'],['periculum','Gefahr','8'],['persequi','verfolgen','30'],['placidus','friedlich, ruhig','22'],['plenus','voll','6'],['plus','mehr','23'],['porta','Tor','4'],['possidere','besitzen','29'],['post','nach, hinter','8'],['potens','mächtig, stark','19'],['puer','Junge','1'],['pulcher','schön','5'],['quaerere','fragen, suchen','10'],['quamquam','obwohl','24'],['quando','wann','12'],['quantus','wie groß, wie viel','30'],['rapere','wegführen, rauben','16'],['regere','beherrschen, leiten','19'],['religio','Glaube, Verehrung','22'],['relinquere','verlassen, zurücklassen','6'],['repetere','zurückverlangen, wiederholen','19'],['res','Sache, Angelegenheit','30'],['respondere','antworten','1'],['restituere','wiederherstellen','22'],['rex','König','9'],['ridere','lachen','1'],['Roma','Rom','3'],['salus','Gesundheit, Rettung, Gruß, Glück','8'],['sapere','klug, weise sein','14'],['scire','wissen, kennen','9'],['scribere','schreiben','6'],['sequi','folgen','30'],['servus','Sklave, Diener','7'],['signum','Merkmal, Zeichen, Standarte','11'],['silere','schweigen','20'],['sol','Sonne','3'],['solus','allein, einzig','27'],['soror','Schwester','7'],['spectare','betrachten, ansehen, hinschauen','3'],['stare','stehen','6'],['studere','sich bemühen, studieren','2'],['sum','sein','1'],['superare','besiegen, überwinden','3'],['sustinere','ertragen, standhalten','22'],['taberna','Laden, Wirtschaft','14'],['tangere','berühren','18'],['tempus','Zeit, Umstand','16'],['terra','Erde, Land','7'],['timere','fürchten, Angst haben','1'],['tradere','übergeben, überliefern','22'],['trahere','schleppen, ziehen','6'],['tres','drei','16'],['ubi','wo','4'],['unus','einer, ein einziger','11'],['urbs','Stadt','7'],['uti','benutzen, gebrauchen','30'],['valere','gesund sein, stark sein, Einfluss haben','3'],['venire','kommen','4'],['ventus','Wind','16'],['verbum','Wort, Äußerung','4'],['vereri','fürchten, sich scheuen, verehren','30'],['vero','aber, in der Tat, wirklich','30'],['vestis','Kleidung','14'],['via','Weg, Straße','1'],['victoria','Sieg','21'],['videre','sehen','3'],['villa','Haus, Landhaus','1'],['vinum','Wein','6'],['vir','Mann','5'],['virtus','Tapferkeit, Tüchtigkeit, Leistung','7'],['vocare','nennen, benennen, rufen','3'],['voluntas','Wille, Absicht','8'],['vita','Leben','12'],['vitium','Fehler, schlechte Eigenschaft','28'],['vivere','leben','10'],['vox','Stimme, Äußerung, Laut','8']
];
let selectedLesson='all', qi=0,ri=0,ci=0,flipped=false;let stats=JSON.parse(localStorage.getItem('vocalatinStats')||'{"score":0,"wrong":0,"stars":[]}');
const lessons=[...new Set(vocab.map(v=>v[2]))].sort((a,b)=>Number(a)-Number(b));
function pool(sel){return sel==='all'?vocab:vocab.filter(v=>v[2]===sel)}
function fillSelect(id){let s=document.getElementById(id);s.innerHTML='<option value="all">Alle Lektionen</option>'+lessons.map(l=>`<option value="${l}">Lektion ${l}</option>`).join('')}
function init(){['quizLesson','reverseLesson','cardLesson','searchLesson'].forEach(fillSelect);document.getElementById('homeLessons').innerHTML='<button class="lesson active" onclick="chooseLesson(\'all\')">Alle</button>'+lessons.map(l=>`<button class="lesson" onclick="chooseLesson('${l}')">${l}</button>`).join('');newQuiz();newReverse();newCard();renderSearch();updateStats()}
function chooseLesson(l){selectedLesson=l;['quizLesson','reverseLesson','cardLesson','searchLesson'].forEach(id=>document.getElementById(id).value=l);newQuiz();newReverse();newCard();renderSearch();document.getElementById('homeLessonInfo').textContent=l==='all'?'Alle Lektionen ausgewählt':'Lektion '+l+' ausgewählt';document.querySelectorAll('.lesson').forEach(b=>b.classList.toggle('active',b.textContent===(l==='all'?'Alle':l)))}
function show(id,btn){document.querySelectorAll('section').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='quiz')newQuiz();if(id==='reverse')newReverse();if(id==='cards')newCard();if(id==='search')renderSearch();if(id==='stats')renderDifficult()}
function openSection(id){let b=[...document.querySelectorAll('nav button')].find(x=>x.getAttribute('onclick')?.includes("'"+id+"'"));show(id,b)}
function rand(n){return Math.floor(Math.random()*n)}
function newQuiz(){let p=pool(document.getElementById('quizLesson').value);if(!p.length)return;qi=rand(p.length);let w=p[qi];document.getElementById('qWord').textContent=w[0];document.getElementById('qFeedback').textContent='';let answers=[w[1]];while(answers.length<4){let x=p[rand(p.length)][1];if(!answers.includes(x))answers.push(x)}answers.sort(()=>Math.random()-.5);document.getElementById('choices').innerHTML=answers.map(a=>`<button class="choice" onclick="checkQuiz('${esc(a)}')">${a}</button>`).join('')}
function checkQuiz(a){let p=pool(document.getElementById('quizLesson').value),w=p[qi];let ok=a.toLowerCase()===w[1].toLowerCase();document.getElementById('qFeedback').textContent=ok?'✅ Richtig!':'❌ Lösung: '+w[1];ok?stats.score++:stats.wrong++;if(!ok)addStar(w[0]);save()}
function newReverse(){let p=pool(document.getElementById('reverseLesson').value);if(!p.length)return;ri=rand(p.length);document.getElementById('rWord').textContent=p[ri][1];document.getElementById('rInput').value='';document.getElementById('rFeedback').textContent=''}
function checkReverse(){let p=pool(document.getElementById('reverseLesson').value),w=p[ri],a=document.getElementById('rInput').value.trim().toLowerCase();let ok=a===w[0].toLowerCase();document.getElementById('rFeedback').textContent=ok?'✅ Richtig!':'❌ Lösung: '+w[0];ok?stats.score++:stats.wrong++;if(!ok)addStar(w[0]);save()}
function newCard(){let p=pool(document.getElementById('cardLesson').value);if(!p.length)return;ci=rand(p.length);flipped=false;document.getElementById('flash').textContent=p[ci][0];document.getElementById('cardFeedback').textContent=''}
function flipCard(){flipped=!flipped;let p=pool(document.getElementById('cardLesson').value);document.getElementById('flash').textContent=flipped?p[ci][1]:p[ci][0]}
function cardResult(ok){let p=pool(document.getElementById('cardLesson').value),w=p[ci];ok?stats.score++:stats.wrong++;if(!ok)addStar(w[0]);save();document.getElementById('cardFeedback').textContent=ok?'👍 Super!':'💡 Wiederholen!';setTimeout(newCard,350)}
function renderSearch(){let q=(document.getElementById('searchInput')?.value||'').toLowerCase();let l=document.getElementById('searchLesson')?.value||'all';let list=pool(l).filter(v=>(v[0]+' '+v[1]).toLowerCase().includes(q));document.getElementById('wordList').innerHTML=list.map(v=>`<div class="wordrow"><div><b>${v[0]}</b> – ${v[1]}</div><span class="badge">Lektion ${v[2]}</span><button class="star" onclick="toggleStar('${esc(v[0])}')">${stats.stars.includes(v[0])?'⭐':'☆'}</button></div>`).join('')||'<p class="small">Keine Vokabel gefunden.</p>'}
function addStar(w){if(!stats.stars.includes(w))stats.stars.push(w)}function toggleStar(w){stats.stars.includes(w)?stats.stars=stats.stars.filter(x=>x!==w):stats.stars.push(w);save();renderSearch();renderDifficult()}
function renderDifficult(){let a=stats.stars.map(w=>vocab.find(v=>v[0]===w)).filter(Boolean);document.getElementById('difficult').innerHTML=a.length?a.map(v=>`<div class="wordrow"><div><b>${v[0]}</b> – ${v[1]}</div><span class="badge">Lektion ${v[2]}</span></div>`).join(''):'<p class="small">Noch keine schwierigen Vokabeln ⭐</p>'}
function save(){localStorage.setItem('vocalatinStats',JSON.stringify(stats));updateStats();renderDifficult()}
function updateStats(){let t=stats.score+stats.wrong,p=t?Math.round(stats.score/t*100):0;['score','wrong','total'].forEach(id=>document.getElementById(id).textContent=id==='total'?t:stats[id]);document.getElementById('bar').style.width=p+'%';document.getElementById('quote').textContent=p+' % richtig';document.getElementById('homeScore').textContent=stats.score;document.getElementById('homeTotal').textContent=t;document.getElementById('homeBar').style.width=p+'%'}
function resetStats(){if(confirm('Fortschritt wirklich zurücksetzen?')){stats={score:0,wrong:0,stars:[]};save()}}
function esc(s){return s.replaceAll('\\','\\\\').replaceAll("'","\\'")}
init();
</script>
</body></html>